{
  "name": "trinity-marine-station",
  "version": "0.5.1-phase4.5",
  "private": true,
  "description": "Next-generation, agentic-first marine navigation station. JEPA world model + conscious narrator (Ollama or OpenAI-compatible cloud) + Signal K + vessel-agent telemetry + A2A frontend mutations + JSONL audit log. Cognitive-layer sibling of SuperInstance/vessel-agent.",
  "scripts": {
    "streamer":     "node backend/mockSignalK.js",
    "ingest":       "node backend/telemetryIngest.js",
    "narrator":     "node backend/llmNarrator.js",
    "daemon":       "node backend/trinityDaemon.js",
    "start":        "node backend/trinityDaemon.js",
    "dev":          "node --watch backend/trinityDaemon.js",
    "status":       "node -e \"require('http').get('http://127.0.0.1:8787/status',r=>{let d='';r.on('data',c=>d+=c);r.on('end',()=>console.log(JSON.stringify(JSON.parse(d),null,2)))})\"",
    "health":       "node -e \"require('http').get('http://127.0.0.1:8787/health',r=>{let d='';r.on('data',c=>d+=c);r.on('end',()=>console.log(d))})\"",
    "lint":         "node tools/lint.js",
    "audit:links":      "node tools/auditLinks.js",
    "audit:status":     "node tools/auditStatus.js",
    "audit":            "node tools/auditLinks.js && node tools/auditStatus.js",
    "verify":           "node tools/auditLinks.js && node tools/auditStatus.js && npm run lint && npm test",
    "regen:status":     "node tools/regenStatus.js",
    "test:pipeline":     "node tests/pipeline.test.js",
    "test:lifecycle":    "node tests/trinityLifecycle.test.js",
    "test:ollama":       "node tests/ollama.smoke.test.js",
    "test:openai":       "node tests/openai.smoke.test.js",
    "test:vector":       "node tests/vectorStore.test.js",
    "test:daemon":       "node tests/daemon.test.js",
    "test:schemas":      "node tests/schemas.test.js",
    "test:circuit":      "node tests/circuitBreaker.test.js",
    "test:health":       "node tests/healthCheck.test.js",
    "test:h3":           "node tests/h3.test.js",
    "test:vessel":       "node tests/vesselAgentAdapter.test.js",
    "test:a2alog":       "node tests/a2aLog.test.js",
    "test:a2abridge":    "node tests/a2aBridge.test.js",
    "test:a2aclient":    "node tests/a2aClient.test.js",
    "test":              "node tests/run.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "ws": "^8.16.0"
  },
  "type": "commonjs"
}